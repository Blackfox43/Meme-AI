# .env.example
GEMINI_API_KEY=

# PayPal Global Payment Gateway (Live or Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_PAYMENT_LINK_ANNUAL=
PAYPAL_PAYMENT_LINK_MONTHLY=

# Paddle Billing & Merchant of Record (Paddle.js & Server API)
PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET_KEY=
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRICE_ANNUAL=pri_01meme_annual_pro
PADDLE_PRICE_MONTHLY=pri_01meme_monthly_pro


# Capacitor / mobile APK – backend URL for API calls (no trailing slash)
# Leave empty for web (same-origin /api). For APK set your deployed server:
# VITE_API_BASE_URL=https://your-memeai-server.example.com
VITE_API_BASE_URL=
